//!imagexd
// This is a comment for the imagexd macro - you can use this macro like a programing language
// For more infos, please see https://stark-jena.de | imagexd
// Copyright (c) 2017-2021 by Heiko Stark

// *************************************************

@variable denotes variables.
Assignment := are only used if the stack type is the same (image := image.func) or a result (10 := image.func).

// *************************************************

clean // same as new
new // clean memory - all scalar, vector, tensor, mesh and line
dump // dump // dump all scalar, vector, tensor, mesh and line workspace lists

// *************************************************

// imagemagick.enable // imagemagick.disable

// Note: The bit level is relevant, if a new image is created (i.e. image.load or first time image.use)!
// image.8bit // set image workspace to 8bit
// image.16bit // set image workspace to 16bit
// image.24bit // set image workspace to 8bit rgb (Default)
// image.32bit // set image workspace to 8bit rgba

// image.value // set image value
// image.background // set image background

// image.use new1 // create new image workspace
// image.name old1 // rename
// image.dump // dump image workspace list

// image.clean // clean image - same as image.new <0, 0>
// image.new x y // or <x, y> or empty - clear field (1..x 1..y)

// a := @image.center // image center <x,y>
// a := @image.size // image size <x,y>
// a := image.min // min pixel value
// a := image.max // max pixel value
// a := image.count 0 128 // pixel count with values from 0..128

// image.load image.input // load a file
//      8bit+16bit (pnm, pbm, pgm, ppm, bmp, dib, imgf)
//      24bit+32bit (pnm, pbm, pgm, ppm, bmp, dib, rgb)
//      with Imagemagick (over 200 data formats, including PNG, JPEG, JPEG-2000, GIF, TIFF, DPX, EXR, WebP, Postscript, PDF, and SVG)
// image.loadpnm image.input // load a pnm(pbm, pgm, ppm)-file
// image.loadbmp image.input // load a bmp(dib)-file
// image.loadimgf image.input // load a imgf-file (only 8bit+16bit)
// image.loadrgb image.input // load a rgb-file (only 24bit+32bit)
// image.loadraw image.input 0 100 100 // load a headerless (0) 100x100 rgb-file (only 16bit, 24bit or 32bit auto detection)
// image.save newfile // save a file
//      8bit+16bit (pgm, tif, png)
//      24bit+32bit (pbm, pgm, ppm, pam, bmp, dib, tga, tif, png, rgb)
//      with Imagemagick (over 200 data formats, including PNG, JPEG, JPEG-2000, GIF, TIFF, DPX, EXR, WebP, Postscript, PDF, and SVG)

// image.crop 10 // crop a image to a new subimage with values below 10
// new := image.copy // copy a image to new
// image.copy.method 1 // 0=sum 1=mean(default) 2=sd // binning only for copyscale
// new := image.copyscale 0.5 // copy and scale a image to new
// new := image.copyscale.label 0.5 // copy and scale a image to new, without label averaging (max. value count)
// new := image.sub <10,10> <20,20,20> // copy a part from a image to new

// image.split.rgb // split rgb image into (name.red, name.green, name.blue) gray images
// image.split.rgba // split rgba image into (name.red, name.green, name.blue, name.alpha) gray images
// image.split.rainbow // split rgb image into (name.red, name.green, name.blue, name.yellow, name.cyan, name.purple, name.gray) gray images
// image.split.rainbow.shift 2 // split (rgb8 -> rgb6) image into (see above) gray images (not shifted)
// image.split.colorpoint <0, 0, 0> <255, 255, 255> ... // split image into several images with points nearest to colorpoint (name.1, name.2, ...)
// new := image.combine name.red name.green name.blue // combine gray images (only three or four) into rgb (24bit) or rgba (32bit) image

// new := image.select old1 6 // new := if old1 into value or range then set new to old1
// new := image.select old1 6 1 // new := if old1 into value or range then set new to 1
// new := image.select old1 <128, 255> // new := if old1 into value or range then set new to old1
// new := image.select old1 <128, 255> 1 // new := if old1 into value or range then set new to 1
// new := image.group old1 <128, 255> // new := if old1 into value or range then assign to group
// new := image.addgroup old1 <128, 255> // new := if old1 into value or range then assign to group
// new := image.mingroup old1 <128, 255> 99 // new := if old1 into value or range then assign to group (if group > 99 pixel)

// new := image.mask old1 mask 0 <1..10> ... // new := if mask = (0 or 1..10 or ...) use old1

// new := image.sub old1 old2 // new := old1 - old2
// new := image.sub.range old1 old2 // new := rangecenter + (old1 - old2)
// new := image.add old1 old2 // new := old1 + old2 // also new := old1 + old2 + old3
// new := image.mean old1 old2 // new := (old1 + old2)/2 // also new := (old1 + old2 + old3)/3
// new := image.median old1 old2 old3 // new := old2 if old1 < old2 < old3
// new := image.intensity old1 old2 1/2 1 // new := (old1/1/2 + old2/1)/2 * (1/2+1)/2 // intensity mapping for 1/2 s and 1 s

// image.setsign // for wrapped values 32768..65535..0..32767 (signed values) -> 0..65535
// image.setrange // put first value to zero (if wrapped values, it does setsign)
// image.setcrop // for single spots (begin and end)
// image.setlower 7 0 // set ...7 to 0
// image.setvalue <7, 247> 247 // set for 8bit and 16bit -> 7..247 to 247
// image.setvalue <128, 0, 0> <128, 0, 255> // set for 24bit and 32bit -> <128, 0, 0> to <128, 0, 255>
// image.sethigher 247 247 // set 247... to 247
// image.setadjust // adjust the gray level - e.g. 10..200 -> 0..255 or 0..65535
// image.setadjust <10,200> // adjust the gray level - eg. 10..200 -> 0..255 or 0..65535
// image.setadjust <10,200> <5,250> // adjust the gray level - eg. 10..200 -> 5..250
// image.setadjust.one // adjust the gray level - eg. (1%)±10..200±(1%) -> 0..255 or 0..65535
// image.setadjust.percentage 0.05 // adjust the gray level - eg. (5%)±10..200±(5%) -> 0..255 or 0..65535
// image.setadjust.percentage 0.05 0.01 // adjust the gray level - eg. (5%)±10..200±(1%) -> 0..255 or 0..65535
// image.setadjust.percentage.weak 0.05 0.01 // adjust the gray level - eg. (5%)±10..200±(5%) -> 0..255 or 0..65535
// image.setadjust.percentage.weak 0.05 0.01 0.03 0.01 // adjust the gray level - eg. (5%)±10..200±(3%) -> (1%)±0..255±(1%) or (1%)±0..65535±(1%)
// image.setadjust.outliers // adjust the gray level - eg. (1/4(q2-q1))±10..200±(1/4(q3-q2)) -> 0..255 or 0..65535
// image.setequal // adjust the gray level to a equal distribution

// image.setpeaklower // eg. 100..peak..200 -> -50..0..50
// image.setpeakmiddle // eg. 100..peak..200 -> 78..128..178 or 32718..32768..32818
// image.setpeakhigher // eg. 100..peak..200 -> 205..255..305 or 65485..65535..65585

// image.setpeak.local 128 <64,192> // for a peak into 64..192 - eg. 100..peak..200 -> 78..128..178
// image.setpeak.localred 128 <64,192> // for a peak into red 64..192 - eg. all rgb 100..peak..200 -> 78..128..178
// image.setpeak.localgreen 128 <64,192> // for a peak into green 64..192 - eg. all rgb 100..peak..200 -> 78..128..178
// image.setpeak.localblue 128 <64,192> // for a peak into blue 64..192 - eg. all rgb 100..peak..200 -> 78..128..178

// image.setbalance <-100, -100, -100> <-100, 0, 100> <100, 100, 100> // set for 24bit and 32bit -> color balance for shadows, midtones and highlights (with preserving luminosity)
// image.setbalance.shadows <-100, -100, -100> // set for 24bit and 32bit -> color balance for shadows (with preserving luminosity)
// image.setbalance.midtones <-100, 0, 100> // set for 24bit and 32bit -> color balance for midtones (with preserving luminosity)
// image.setbalance.highlights <100, 100, 100> // set for 24bit and 32bit -> color balance for highlights (with preserving luminosity)

// image.setmin.red <0, 0, 0> // set for 24bit and 32bit -> (<0, 255, 255>; <0,255,10>; <0,128,1>; ...) to <0, 0, 0>
// image.setmin.green .blue, .yellow, .cyan, .purple - see above
// image.setmax.red <0, 0, 0> // set for 24bit and 32bit -> (<255, 0, 0>; <255,250,10>; <255,128,254>; ...) to <0, 0, 0>
// image.setmax.green .blue, .yellow, .cyan, .purple - see above

// image.mono 128 // binary value with threshold
// image.gray // only rgb and rgba
// image.hdrgray // only rgb and rgba

// image.softsmooth
// image.smooth
// image.hardsmooth
// image.unsharpmasking
// image.cleanup // image.setadjust + image.smooth + 2*image.unsharpmasking

// Note: image.shrink = image.erode, image.fullshrink = image.fullerode, image.grow = image.dilate, image.fullgrow = image.fulldilate
// image.shrink <128, 255> 4 // remove single spots, if 4 neighbors (max 8) outside value or range
// image.shrink <128, 255> 4 1 // replace single spots with 1, if 4 neighbors (max 8) outside value or range
// image.fullshrink (see above) // loop image.shrink until be found no more shrinking points or iteration steps > 9999
// image.grow <128, 255> 4 // fill single hole, if 4 neighbors (max 8) inside value or range
// image.grow <128, 255> 4 1 // replace single hole with 1, if 4 neighbors (max 8) inside value or range
// image.fullgrow (see above) // loop image.grow until be found no more growing points or iteration steps > 9999
// image.open (see above) // shrink + grow
// image.close (see above) // grow + shrink
// image.close <128, 255> 4 4 1 1 // grow <128, 255> 4 1 + shrink <128, 255> 4 1

// image.remove.outliers 2 // if value outside of median+/-(factor * abs(q.25-q.75))

// image.histogram // write histogram to stdout
// image.histogram.image histogram.pgm // save histogram image
// image.histogram.raw histogram.txt // save histogram values
// image.analysis // write analysis to stdout
// image.analysis.image analysis.pgm // save histogram + analysis image
// image.analysis.raw analysis.txt // save histogram + analysis values

// image.window.sin // Sine window function 
// image.window.cos // Cosine window function

// image.flipx
// image.flipy

// image.vertical.sum // pixel sum output to stdout
// image.vertical.sum 128 // from column 128 pixel output to stdout
// image.vertical.sum 128 50 // from column 78-128-178 pixel sum output to stdout
// image.vertical.mean (see above) // pixel mean output to stdout
// image.vertical.sd (see above) // pixel sd output to stdout

// image.horizontal.sum (see above) // pixel sum output to stdout
// image.horizontal.mean (see above) // pixel mean output to stdout
// image.horizontal.sd (see above) // pixel sd output to stdout

// *************************************************

// Note: The bit level is relevant, if a new scalar is created (i.e. scalar.load or first time scalar.use)!
// scalar.8bit // set scalar workspace to 8bit
// scalar.16bit // set scalar workspace to 16bit (Default)

// scalar.value // set scalar value
// scalar.background // set scalar background

// new := scalar.select old1 6 // new := if old1 into value or range then set new to old1
// new := scalar.select old1 6 1 // new := if old1 into value or range then set new to 1
// new := scalar.select old1 <128, 255> // new := if old1 into value or range then set new to old1
// new := scalar.select old1 <128, 255> 1 // new := if old1 into value or range then set new to 1
// new := scalar.group old1 <128, 255> // new := if old1 into value or range then assign to group
// new := scalar.addgroup old1 <128, 255> // new := if old1 into value or range then assign to group
// new := scalar.mingroup old1 <128, 255> 99 // new := if old1 into value or range then assign to group (if group > 99 pixel)

// new := scalar.milling.xy old1 mask 0 <1,10> ... // new := if mask = (0 or 1..10 or ...) use old1 // mask = image
// new := scalar.milling.yz old1 mask 0 <1,10> ... // new := if mask = (0 or 1..10 or ...) use old1 // mask = image
// new := scalar.milling.xz old1 mask 0 <1,10> ... // new := if mask = (0 or 1..10 or ...) use old1 // mask = image
// new := scalar.mask old1 mask 0 <1,10> ... // new := if mask = (0 or 1..10 or ...) use old1

// new := scalar.sub old1 old2 // new := old1 - old2
// new := scalar.sub.range old1 old2 // new := rangecenter + (old1 - old2)
// new := scalar.add old1 old2 // new := old1 + old2
// new := scalar.mean old1 old2 // new := (old1 + old2)/2
// new := scalar.median old1 old2 old3 // new := old2 if old1 < old2 < old3
// new := scalar.intensity old1 old2 80 120 // new := (old1/80 + old2/120)/2 * (80+120)/2 // intensity mapping for 80 kV and 120 kV
// new := scalar.intensity old1 old2 old3 80 100 120 // new := (old1/80 + old2/100 + old3/120)/3 * (80+100+120)/3 // intensity mapping for 80 kV, 100 kV and 120 kV

// Note: ALL following functions using the scalar field from scalar.use!
// scalar.use new1 // create new scalar workspace
// scalar.name old1 // rename
// scalar.dump // dump scalar workspace list

// scalar.clean // clean scalar - same as scalar.new <0, 0, 0>
// scalar.new x y z // or <x, y, z> or empty - new field (1..x 1..y 1..z)
// scalar.offset.center // set offset to field center
// scalar.offset <x, y, z> // scalar.offset // set offset to zero
// scalar.scale <x, y, z>
// scalar.matrix <x1, y1, z1> <x2, y2, z2> <x3, y3, z3> // scale and rotation matrix

// a := @scalar.center // scalar center <x,y,z>
// a := scalar.object.center 0 128 // center ((min+max)/2) from values 0..128
// a := @scalar.size // scalar size <x,y,z>
// a := scalar.object.size 0 128 // size (max-min) from values 0..128
// a := scalar.min // min pixel value
// a := scalar.max // max pixel value
// a := scalar.count 0 128 // pixel count with values from 0..128
// a := scalar.statistic 0 128 // pixel mean SD with values from 0..128
// a := scalar.statistic 0 0.5 128 // pixel mean*0.5 SD*0.5 with values from 0..128
// a := scalar.quantile 0 128 // pixel min q.25 median q.75 max with values from 0..128
// a := scalar.quantile 0 0.5 128 // pixel min*0.5 q.25*0.5 median*0.5 q.75*0.5 max*0.5 with values from 0..128
// a := scalar.centroid 0 128 // centroid from values 0..128
// a := scalar.cog 0 128 // cog from values 0..128

// scalar.labels.new // clear all labels
// scalar.labels.clean // clear all labels

// scalar.load.labels scalar.txt // load a label file (atlas.xml, tab separated [1#name] or plain [name]) - maximal 0-999 labels
// count := scalar.labels.length // get number of labels
// name := scalar.label 1 // get label name for index 1
// scalar.label 1 "exterior" // set label name "exterior" for index 1
// scalar.labels.dump // dump all labels

// scalar.load.filter 12000 // filter integer values 12000+value (Default 0)
// scalar.load.filter 12000 10 // filter integer values (12000+value)*10 (Default 0 1)
// scalar.load.filter 12000 -2 // filter integer values (12000+value)/2 (Default 0 1)
// scalar.load scalar.input // load a file or files (nii, nii.gz, (hdr+img), mif, pcr and (pnm or bmp) stacks)
// scalar.load.hdr scalar.input // load a analyze7.5(hdr,img)-file
// scalar.load.nii scalar.input // load a nifti-file (and .atlas.xml if available)
// scalar.load.nii.gz scalar.input // load a zipped nifti-file
// scalar.load.mif scalar.input // load a mif-file
// scalar.load.pcr scalar.input // load a (pcr,vol)-file
// scalar.load.raw scalar.input 452 "byte" <10 , 10, 10> // load a raw-file (header=452 type=byte,word,longword,quadword,single,double,extended,rgb,rgba,wordrgb,wordrgba type=signbyte,...)
// scalar.load.scale scalar.input <x, y, z>// load (pnm or bmp) stacks with specific scale)
// scalar.append scalar.input // load a file or files (nii, nii.gz, (hdr+img), mdf and (pnm or bmp) stacks into a scalar field)
// scalar.appendcenter scalar.input // load a centered file or files (nii, nii.gz, (hdr+img), mdf and (pnm or bmp) stacks into a scalar field)
// scalar.save newfile // save a file (nii, nii.gz, (hdr+img) or (pnm, bmp, tga, tif or png))

// old := scalar.make.scalar // init scalar field with dimensions from used scalar field
// scalar.make.vector // init used vector field with dimensions from used scalar field
// old := scalar.make.vector // init vector field with dimensions from used scalar field
// scalar.crop <1, 10> // crop scalar field with value or range <1, 10>
// new := scalar.crop <1, 10> // crop scalar field to new substack with value or range <1, 10>
// new := scalar.crop old1 <1, 10> // crop scalar field old1 to new substack with value or range <1, 10>
// new := scalar.crop old1 mask <1, 10> // crop scalar field old1 to new substack with mask value or range <1, 10>
// scalar.move <10, 10, 10> <20, 20, 20> <50, 50, 50> // move block <10, 10, 10> <20, 20, 20> to <50, 50, 50>
// scalar.copy.method 1 // 0=sum 1=mean(default) 2=sd 3=min 4=Q.25 5=median 6=Q.75 7=max // binning only for scalar.copyscale
// new := scalar.copy // copy scalar field to new
// new := scalar.copy 0.5 // isometric copy and scale scalar field to new
// new := scalar.copy <0.5,0.5,1> // anisometric copy and scalar scalar field to new
// new := scalar.copy.label 0.5 // copy and scale scalar field to new, without label averaging (max. value count)
// new := scalar.substack <10,10,10> <20,20,20> // copy a substack from scalar field to new

// scalar.setendian // swap endianess $ABCD -> $CDAB
// scalar.setsign // for wrapped values 32768..65535..0..32767 (signed values) -> 0..65535
// scalar.setrange // put first value to zero (if wrapped values, it does setsign)
// scalar.setcrop // for single spots (begin and end)
// scalar.setlower 7 0 // set ...7 to 0
// scalar.setvalue <7, 247> 247 // set for 8bit and 16bit -> 7..247 to 247
// scalar.sethigher 247 247 // set 247... to 247
// scalar.setadjust // adjust the gray level - eg. 10..200 -> 0..255 or 0..65535
// scalar.setadjust <10,200> // adjust the gray level - eg. 10..200 -> 0..255 or 0..65535
// scalar.setadjust <10,200> <5,250> // adjust the gray level - eg. 10..200 -> 5..250
// scalar.setadjust.one // adjust the gray level - eg. (1%)±10..200±(1%) -> 0..255 or 0..65535
// scalar.setadjust.percentage 0.05 // adjust the gray level - eg. (5%)±10..200±(5%) -> 0..255 or 0..65535
// scalar.setadjust.percentage 0.05 0.01 // adjust the gray level - eg. (5%)±10..200±(1%) -> 0..255 or 0..65535
// scalar.setadjust.percentage.weak 0.05 0.01 // adjust the gray level - eg. (5%)±10..200±(5%) -> 0..255 or 0..65535
// scalar.setadjust.percentage.weak 0.05 0.01 0.03 0.01 // adjust the gray level - eg. (5%)±10..200±(3%) -> (1%)±0..255±(1%) or (1%)±0..65535±(1%)
// scalar.setadjust.outliers // adjust the gray level - eg. (1/4(q2-q1))±10..200±(1/4(q3-q2)) -> 0..255 or 0..65535
// scalar.setequal // adjust the gray level to a equal distribution

// scalar.setpeaklower // 100..peak..200 -> -50..0..50
// scalar.setpeakhigher // 100..peak..200 -> 205..255..305 or 65485..65535..65585
// scalar.setpeakmiddle // 100..peak..200 -> 78..128..178 or 32718..32768..32818

// scalar.fill 10 // fill field with 10
// scalar.fill.random // fill field with random values
// scalar.fill.cube <1,1,1> <0,0,0> 10 // fill subfield (1,1,1 .. x/2,y/2,z/2) with 10
// scalar.fill.holes <5,15> 10 // fill holes with 10 from structures 5..15
// scalar.invert // invert field

// scalar.softsmooth // midpoint is stronger
// scalar.smooth // all the same
// scalar.hardsmooth // midpoint is weaker
// scalar.unsharpmasking // sharp edges
// scalar.cleanup // scalar.setadjust + scalar.smooth + 2*scalar.unsharpmasking

// Note: For label fields, please use the three parameters, otherwise the labels are averaged!
//       You can only do this with a 8bit and 16bit scalar!
//       scalar.shrink = scalar.erode, scalar.fullshrink = scalar.fullerode, scalar.grow = scalar.dilate, scalar.fullgrow = scalar.fulldilate
// scalar.shrink <128, 255> 13 // remove single spots, if 13 neighbors (max 26) outside value or range
// scalar.shrink <128, 255> 13 1 // replace single spots with 1, if 13 neighbors (max 26) outside value or range
// scalar.fullshrink (see above) // loop scalar.shrink until be found no more shrinking points or iteration steps > 9999
// scalar.grow <128, 255> 13 // fill single hole, if 13 neighbors (max 26) inside value or range
// scalar.grow <128, 255> 13 1 // replace single hole with 1, if 13 neighbors (max 26) inside value or range
// scalar.fullgrow (see above) // loop scalar.grow until be found no more growing points or iteration steps > 9999
// scalar.open (see above) // shrink + grow
// scalar.close (see above) // grow + shrink
// scalar.close <128, 255> 4 4 1 1 // grow <128, 255> 4 1 + shrink <128, 255> 4 1

// scalar.remove.outliers 2 // if value outside of median+/-(factor * abs(q.25-q.75))

// scalar.info scalar.input out.txt // save header info from nii or .. files.
// scalar.histogram // write histogram to stdout
// scalar.histogram.image histogram.pgm // save histogram image
// scalar.histogram.raw histogram.txt // save histogram values
// scalar.analysis // write analysis to stdout
// scalar.analysis.image analysis.pgm // save histogram + analysis image
// scalar.analysis.raw analysis.txt // save histogram + analysis values

// scalar.gradient overview.pgm // overview with decreasing gradient intensities
// scalar.hull overview.pgm // overview from hull with intensities > 0
// scalar.low overview.pgm // overview with only the lowest intensities
// scalar.high overview.pgm // overview with only the highest intensities
// scalar.xray overview.pgm // overview with the mean intensities
// scalar.color overview.pgm // overview with the mean colorized intensities
// scalar.count overview.pgm // overview with the cumulative intensities

// see image for further properties
// scalar.xy 0 // xy image from scalar position // 0 means the center
// scalar.yz 0 // yz image from scalar position // 0 means the center
// scalar.xz 0 // xz image from scalar position // 0 means the center
// 1=min 2=mean(default) 3=thresholdmean 4=max
// scalar.xy.z 2 // xy image from scalar
// scalar.yz.x 2 // yz image from scalar
// scalar.xz.y 2 // xz image from scalar

// scalar.convert.length // store values on vector * length
// scalar.convert.x // store values on vector x-axis
// scalar.convert.y // store values on vector y-axis
// scalar.convert.z // store values on vector z-axis

// scalar.fullscan false // true = scan only full spheres (without zero), false(default) = scan incomplete spheres
// new := scalar.measure.mean 10 // measure mean from all inside the block size 2*10 x 2*10 x 2*10
// new := scalar.measure.sd 10 // measure sd from all inside the block size 2*10 x 2*10 x 2*10
// new := scalar.measure.thickness 10 // measure minimal thickness of structures > 0 (thickness max. 10)
// new := scalar.measure.cartoon 10 // measure minimal thickness of structures > 0 and store only if the measure point in center (thickness max. 10)
// scalar.measure.plane 10 // measure plane direction (based on smallest thickness of structure > 0) and store it in a vector field

// scalar.diffusion.map map.pgm 16 // calculate diffusion map from one voxel with scan length at center point
// scalar.diffusion.map map.pgm 16 <0,0,0> // calculate diffusion map from one voxel with scan length at center point
// scalar.diffusion.map map.pgm 16 <10,10,10> // calculate diffusion map from one voxel with scan length at point <10,10,10>
// scalar.diffusion.map map.pgm 16 <10,10,10> <-3,-3,-3> // calculate diffusion map from one voxel with scan length at point <7,7,7>
// scalar.diffusion.map map.pgm 16 <0,0,0> <-3,-3,-3> // calculate diffusion map from one voxel with scan length at center point plus <-3,-3,-3>
// scalar.diffusion.colormap map.ppm 16 ... // calculate diffusion map from one voxel with scan length at center point / ... see above
// scalar.diffusion.dump dump.txt 16 ... // dump diffusion from one voxel with scan length at center point / ... see above
// scalar.diffusion.histogram ... // calculate length histogram from one voxel at center point / ... see above
// scalar.diffusion.sd ... // calculate sd's from one voxel at center point / ... see above

// scalar.submethod 2 // 0=sum 1=mean 2=sd(default) 3=min 4=Q.25 5=median 6=Q.75 7=max
// scalar.fullscan false // true = scan only full spheres (without zero), false(default) = scan incomplete spheres
// scalar.diffusion.method 5 // 1=stark2013 2=stark2014a 3=stark2014b 4=stark2015a 5=stark2015b(default) 6=stark2019 // algorithm for scalar.diffusion
//       stark2013 = only the single best vector – vectorlength = submethod.SD
//       stark2014a = mean the two best vectors, if distance < r/2 – vectorlength = submethod.SD
//       stark2014b = mean (same submethod.SD) best vectors – vectorlength = submethod.SD
//       stark2015a = mean (same submethod.SD) best vectors (around diffusion.angle (rad)), only for diffusion.max (%)
//       stark2015b = mean the best vectors (around diffusion.angle (rad)), only for diffusion.max (%)
//       stark2019  = mean the best vectors (around diffusion.angle (rad)), only for diffusion.max (%) – vectorlength = submethod.SD
// scalar.diffusion.max 0.25 // (%)
// scalar.diffusion.angle 0.08726 // (rad) - 5*(pi/180) = 5°
// scalar.diffusion 16 // calculate a vector field from scalar with voxel scan length
// scalar.diffusion.x2 8 // calculate a half sized vector field from scalar with voxel scan length
// scalar.diffusion.adaptive 16 // calculate a vector field from scalar with voxel scan length - only for scalar div 2 and if fails for subpixels
// scalar.diffusion.adaptive.x2 8 // calculate a half sized vector field from scalar with voxel scan length - only for scalar div 2 and if fails for subpixels

// scalar.submethod 2 // 0=sum 1=mean 2=sd(default) 3=min 4=Q.25 5=median 6=Q.75 7=max
// scalar.fullscan false // true = scan only full spheres (without zero), false(default) = scan incomplete spheres
// scalar.connection.method 4 // 1=hdti 2=dti 3=ddti 4=hardhardi 5=softhardi(default) 6=hardi // algorithm for scalar.connection
//       hdti = similar to three direction (x,y,z)/2 diffusion imaging
//       dti = similar to seven direction (x,y,z + octants)/2 diffusion imaging
//       ddti = similar to thirteen direction 2*(x,y,z + octants + between x,y,z)/2 diffusion imaging
//       hardhardi = similar to high angular resolution diffusion imaging with limit of 64 orientation vectors
//       softhardi = similar to high angular resolution diffusion imaging with limit of 128 orientation vectors
//       hardi = similar to high angular resolution diffusion imaging
// scalar.connection 16 // calculate a tensor field from scalar with voxel scan length
// scalar.connection.x2 8 // calculate a half sized tensor field from scalar with voxel scan length
// scalar.connection.aniso 16 // calculate a tensor field from scalar with min (anisotropic) voxel scan length (only for hardi)
// scalar.connection.aniso.x2 8 // calculate a half sized tensor field from scalar with min (anisotropic) voxel scan length (only for hardi)

// scalar.weaksurface 128 // generate a mesh surface from scalar values (>= 128) - smoothen with scalar values
// scalar.smoothsurface 1 // generate a smooth mesh surface from a scalar value or range - smoothen with local voxel density
// scalar.surface 1 // generate a mesh surface from a scalar value or range
// scalar.cube <1, 5> // generate a hard (cube) mesh surface from a scalar value or range

// scalar.fill.t // fill line t values with scalar values
// scalar.fill.t.mean // fill line t values with scalar mean (around -1..1) values
// scalar.fill.t.sd // fill line t values with scalar sd (around -1..1) values
// scalar.tetrahedron 128 // generate a tetrahedron mesh (in line) from a scalar value or range
// scalar.tetrahedron <128,255> -1000 0.001 // generate a tetrahedron mesh (in line) from a scalar value or range and fill (t-values-1000)*0.001
// scalar.hexahedron 32768 // generate a hexahedron mesh (in line) from a scalar value or range
// scalar.hexahedron <32768, 65535> -1000 0.001 // generate a hexahedron mesh (in line) from a scalar value or range and fill (t-values-1000)*0.001

// scalar.getpoint <10, 100> // points – stored in line as points (t = value)
// scalar.getpoint <10, 100> 10 // points – stored in line as points (t = 10)
// scalar.getvector <10, 100> // local gradient vectors – stored in line as vectors (t = value from – to)
// scalar.getvector <10, 100> 10 // local gradient vectors – stored in line as vectors (t = 10)
// scalar.getray <0,0,0> 20 <10, 100> // statistical values from center <0,0,0> with raylength 20 from a scalar value or range – stored as line

// *************************************************

// Note: The bit level is relevant, if a new vector field is created (i.e. vector.load or first time vector.use)!
// vector.integer // set vector workspace to (int32 or int64)
// vector.float // set vector workspace to (float80 or float64) (Default)
// vector.24bit // set scalar workspace to 8bit rgb

// new := vector.mask old1 scalarmask 0 <1..10> ... // new := if scalarmask = (0 or 1..10 or ...) use old1

// new := vector.sub old1 old2 // new := old1 - old2 // also possible new := old1 - old2
// new := vector.add old1 old2 // new := old1 + old2 // also possible new := old1 + old2
// new := vector.mean old1 old2 // new := (old1 + old2)/2 // also possible new := (old1 + old2)/2

// Note: ALL following functions using the vectorfield from vector.use!
// vector.use new1 // create new vector workspace
// vector.name old1 // rename
// vector.dump // dump vector workspace list

// vector.clean // clean vector field - same as vector.new <0, 0, 0>
// vector.new x y z // or <x, y, z> or empty - new vector field (1..x 1..y 1..z)
// vector.offset.center // set offset to field center
// vector.offset <x, y, z> // vector.offset // set offset to zero
// vector.scale <x, y, z>
// vector.matrix <x1, y1, z1> <x2, y2, z2> <x3, y3, z3> // scale and rotation matrix

// vector.load vector.input // load a vector field - (nii, nii.gz or txt)
// vector.append scalar.input // load a load a vector field - (nii, nii.gz or txt) into a vector field)
// vector.save newfile // save vector field (nii, nii.gz, am or txt) - (int32 or int64), float64
// vector.save newfile <0.5, 0.5, 0.5> // save vector field with vector scaling <0.5, 0.5, 0.5>

// old := vector.make.vector // init vector field with dimensions from used vector field
// vector.make.scalar // init used scalar field with dimensions from used vector field
// old := vector.make.scalar // init scalar field with dimensions from used vector field
// vector.crop <1, 10> // crop vector field to new substack with vector length or range <1, 10>
// new := vector.crop <1, 10> // crop vector field to new substack with vector length or range <1, 10>
// new := vector.crop old1 <1, 10> // crop vector field old1 to new substack with vector length or range <1, 10>
// new := vector.crop old1 mask <1, 10> // crop vector field old1 to new substack with mask value or range <1, 10>
// vector.move <10, 10, 10> <20, 20, 20> <50, 50, 50> // move block <10, 10, 10> <20, 20, 20> to <50, 50, 50>
// vector.copy.method 1 // 0=sum(int) 1=mean(default;float) 2=sd(float) 3=min 4=Q.25 5=median 6=Q.75 7=max // binning only for vector.copyscale
// new := vector.copy // copy vector field to new
// new := vector.copy 0.5 // isometric copy and scale vector field to new
// new := vector.copy <0.5,0.5,1> // anisometric copy and scale vector field to new
// new := vector.substack <10,10,10> <20,20,20> // copy a substack from vector field to new

// vector.norm.min // norm vectors based on min value (int32 = -4294967294..4294967295, int64 = -18446744073709551614..18446744073709551615, float = -1..1)
// vector.norm // norm vectors (int32 = -4294967294..4294967295, int64 = -18446744073709551614..18446744073709551615, float = -1..1)
// vector.norm.max // norm vectors based on max value (int32 = -4294967294..4294967295, int64 = -18446744073709551614..18446744073709551615, float = -1..1)
// vector.norm.relative // norm vectors relative to max global vector (int32 = -4294967294..4294967295, int64 = -18446744073709551614..18446744073709551615, float = -1..1)
// vector.setlength 2 // norm vectors and set length to 2
// vector.setlength.relative 2 // norm vectors relative to max global vector and set length to 2
// vector.erase.min 2 // erase vectors (<0,0,0>) with length < 2
// vector.erase.max 2 // erase vectors (<0,0,0>) with length > 2

// vector.background
// vector.cleanup // remove vector, if it near to background vector 
// vector.softsmooth // midpoint is stronger
// vector.smooth // smooth the vector field
// vector.hardsmooth // midpoint is weaker

// vector.measure.length // measure length of vectors and store in scalar
// vector.get.x // get x values of vectors and store in scalar
// vector.get.y // get y values of vectors and store in scalar
// vector.get.z // get z values of vectors and store in scalar

// vector.gettensor // Calculate orientation tensor's from vector field

// vector.stream.seeds 1 // 0:all, 1(default):only at new points, 2:only at new points around -1..1, ...
// vector.stream.snakes 0 // 0(default):all, 1:only for new points, 2:only for new points around -1..1, ...
// vector.stream.steps 1 // streamlines with steps 1(default) (i.e. 0.5 or 2)
// vector.stream.angles 1 // streamlines with segment angle 1°(default) (i.e. 0°, 5°, 10°)
// vector.stream.stop.angle 90 // streamlines stops for wrong directions > 90°(default) (i.e. > 45°)
// vector.stream.stop.length 0 // streamlines stops for too long streamlines (0(default)=diagonal of bounding box)
// vector.stream.stop.contrast 0 // streamlines stops for contrast differences (0(default)=nothing; scalar should be defined)

// vector.stream.nodes // calculate stream lines like vector.stream and increments corresponding scalar value

// Note: Streamlines are stored in the respective coordinate system (offset) with the specified resolution (scale)!
// vector.stream // calculate streamlines for all seed points from a vector field
// vector.stream.random 100 // calculate 100 streamlines
// vector.stream.mask mask 1 <2..10> ... // calculate streamlines for all masked seed points from a vector field
// vector.stream.mask.random 100 mask 1 <2..10> ... // calculate 100 streamlines for masked seed points from a vector field
// vector.stream.muscle // calculate streamlines (only if length left = length right +/- steps) for seed points from a vector field
// vector.stream.muscle.random 100 // calculate 100 streamlines (only if length left = length right +/- steps) for seed points from a vector field
// Note: A zero point <0,0,0> calculates the center point of your stack!
// vector.stream.slice <10,10,10> <1,1,0> // calculate streamlines for all points on a plane (point*normal) from a vector field
// vector.stream.slicex 10 // calculate streamlines for all points on the x plane (value*<1,0,0>) from a vector field
// vector.stream.slicey 10 // calculate streamlines for all points on the y plane (value*<0,1,0>) from a vector field
// vector.stream.slicez 10 // calculate streamlines for all points on the z plane (value*<0,0,1>) from a vector field

// vector.line // get vectors from a vector field (without <0, 0, 0>)

// *************************************************

// Note: The bit level is relevant, if a new tensor field is created (i.e. tensor.load or first time tensor.use)!
// tensor.integer // set tensor workspace to (int32 or int64)
// tensor.float // set tensor workspace to (float80 or float64) (Default)

// new := tensor.mask old1 scalarmask 0 <1,10> ... // new := if scalarmask = (0 or 1..10 or ...) use old1

// Note: ALL following functions using the tensorfield from tensor.use!
// tensor.use new1 // create new tensor workspace
// tensor.name old1 // rename
// tensor.dump // dump tensor workspace list

// tensor.clean // clean tensor field - same as tensor.new <0, 0, 0>
// tensor.new x y z // or <x, y, z> or empty - new tensor field (1..x 1..y 1..z)
// tensor.offset.center // set offset to field center
// tensor.offset <x, y, z> // tensor.offset // set offset to zero
// tensor.scale <x, y, z>
// tensor.matrix <x1, y1, z1> <x2, y2, z2> <x3, y3, z3> // scale and rotation matrix

// tensor.load tensor.input // load a tensor field - (nii or nii.gz)
// tensor.append tensor.input // load a tensor field - (nii or nii.gz) into a tensor field)
// tensor.save newfile // save tensor field (nii, nii.gz, nhdr or nrrd) - (int32 or int64), float64

// old := tensor.make.tensor // init tensor field with dimensions from used tensor field
// tensor.make.scalar // init used scalar field with dimensions from used tensor field
// old := tensor.make.scalar // init scalar field with dimensions from used tensor field
// tensor.move <10, 10, 10> <20, 20, 20> <50, 50, 50> // move block <10, 10, 10> <20, 20, 20> to <50, 50, 50>
// tensor.copy.method 1 // 0=sum(int) 1=mean(default;float) 2=sd(float) 3=min 4=Q.25 5=median 6=Q.75 7=max // binning only for tensor.copyscale
// new := tensor.copy // copy tensor field to new
// new := tensor.copy 0.5 // isometric copy and scale tensor field to new
// new := tensor.copy <0.5,0.5,1> // anisometric copy and scale tensor field to new
// new := tensor.substack <10,10,10> <20,20,20> // copy a substack from tensor field to new

// tensor.measure.e1 // Calculate first eigenvalue – result stored in scalar
// tensor.measure.e2 // Calculate second eigenvalue – result stored in scalar
// tensor.measure.e3 // Calculate third eigenvalue – result stored in scalar
// tensor.measure.fa // Calculate fractional anisotropy – result stored in scalar
// tensor.measure.ra // Calculate relative anisotropy – result stored in scalar
// tensor.measure.md // Calculate mean/trace anisotropy – result stored in scalar
// tensor.measure.axial // Calculate axial anisotropy (same as e1) – result stored in scalar
// tensor.measure.radial // Calculate radial anisotropy (e2+e3)/2 – result stored in scalar
// tensor.measure.linear // Calculate linear anisotropy (e1-e2)/e1 – result stored in scalar
// tensor.measure.planar // Calculate planar anisotropy (e2-e3)/e1 – result stored in scalar
// tensor.measure.spherical // Calculate spherical anisotropy e3/e1 – result stored in scalar
// tensor.measure.vr // Calculate volume ratio – result stored in scalar

// tensor.eigenvalues // Calculate eigenvalues – result stored in vector
// tensor.westin // Calculate Westin-measures (linear,planar,spherical) – result stored in vector
// tensor.eigenvector.max // Calculate first eigenvector – result stored in vector
// tensor.eigenvector.mid // Calculate second eigenvector – result stored in vector
// tensor.eigenvector.min // Calculate third eigenvector – result stored in vector

// *************************************************

// mesh.use new1 // create new mesh workspace
// mesh.name old1 // rename
// mesh.dump // dump mesh workspace list

// mesh.clean // same as mesh.new
// mesh.new

// mesh.load mesh.input // load a mesh file (obj, iv, vrml)
// mesh.save newfile // save a mesh file (obj)

// new := mesh.copy // copy mesh to new
// new := mesh.copy 0.5 // isometric copy and scale mesh to new
// new := mesh.copy <0.5,0.5,1> // anisometric copy and scale mesh to new

// mesh.verification
// mesh.split transform.split // ignored if 0
// mesh.softsmooth transform.smooth // ignored if 0
// mesh.smooth transform.smooth // ignored if 0
// mesh.hardsmooth transform.smooth // ignored if 0

// mesh.adjust 3 // adjust to xy-plane with 3 steps
// mesh.adjust5 3 // for 5% of points
// mesh.adjust10 3 // for 10% of points
// mesh.adjust15 3 // for 15% of points

// mesh.clear.x
// mesh.clear.y
// mesh.clear.z
// mesh.mirror.x
// mesh.mirror.y
// mesh.mirror.z
// mesh.abs.x
// mesh.abs.y
// mesh.abs.z
// mesh.swap.xy
// mesh.swap.yz
// mesh.swap.xz

// mesh.rotate mesh.transform.rotate // ignored if angles <0,0,0>
// mesh.translate mesh.transform.translate // ignored if <0,0,0>
// mesh.scale mesh.transform.scale // ignored if <1,1,1>
// mesh.rotate.relative <0,0,0> mesh.transform.rotate // ignored if angles <0,0,0>
// mesh.translate.relative <0,0,0> mesh.transform.translate // ignored if <0,0,0>
// mesh.scale.relative <0,0,0> mesh.transform.scale // ignored if <1,1,1>

// mesh.set.pivot.zero
// mesh.set.pivot.center // from dimension
// mesh.set.pivot.gravity // from all vertex point
// mesh.set.pivot <1,1,1>
// mesh.center // move to zero
// mesh.recenter // move to pivot
// mesh.rotate.pivot mesh.transform.rotate // ignored if <0,0,0>
// mesh.translate.pivot mesh.transform.translate // ignored if <0,0,0>
// mesh.scale.pivot mesh.transform.scale // ignored if <1,1,1>

// mesh.insideout // flip normals
// mesh.remove.normals // remove normals

// mesh.draw // draw mesh into scalar
// mesh.draw.obj test.obj // draw mesh direct from a obj-file (decrease intensity value for every object)

// mesh.density.method 1 // 0=sum 1=mean(default) 2=sd 3=min 4=Q.25 5=median 6=Q.75 7=max
// mesh.density.min 0 // min value for color 0 (default min=0&max=0 = auto)
// mesh.density.max 1000 // max value for color 1 (default min=0&max=0 = auto)
// mesh.getdensity 10 // skin density (max depth 10) in scalar on vertex points stored in normal vector
// mesh.getdensity.color 10 // skin density (max depth 10) in scalar on vertex points stored in color vector
// mesh.getconnect 10 // air density (max height 10) in scalar on vertex points stored in normal vector
// mesh.getconnect.color 10 // air density (max height 10) in scalar on vertex points stored in color vector
// mesh.getdepth 10 1000 // skin depth (max depth 10 with threshold 1000) in scalar on vertex points stored in normal vector
// mesh.getdepth.color 10 1000 // skin depth (max depth 10 with threshold 1000) in scalar on vertex points stored in color vector

// *************************************************

// line.use new1 // create new line workspace
// line.name old1 // rename
// line.dump // dump line workspace list

// line.clean // same as line.new
// line.new

// line.load line.input // load a cloud2 file
// line.load line.input 20 // load only 20 % randomly from a cloud2 file
// line.save newfile // save lines (obj, dxf, trk, mel, mv3d, swc or txt)
// line.save.obj newfile // save lines (obj file) for Blender, ...
// line.save.dxf newfile // save lines (dxf file) for CAD-software
// line.save.trackvis newfile // save lines (trk file) for TrackVis
// line.save.maya newfile // save lines (mel file) for Maya
// line.save.mv3d newfile // save lines (txt file) for MicroVisu3D
// line.save.swc newfile // save lines (swc file)
// line.save.txt newfile // save lines (txt file)

// new := line.copy // copy line to new
// new := line.copy 0.5 // isometric copy and scale line to new
// new := line.copy <0.5,0.5,1> // anisometric copy and scale line to new – preserve t
// new := line.copy <0.5,0.5,1,2> // anisometric copy and scale line to new

// line.center // center all
// line.center.objects // center objects

// line.number // store point number in t
// line.distance // store near distance in t
// line.length // store line length from origin in t

// line.mean.t // Make mean of all t values on lines
// line.sd.t // Make sd of all t values on lines
// line.min.t // Make min of all t values on lines
// line median.t // Make median of all t values on lines
// line.max.t // Make max of all t values on lines

// line.erase.duplicates // erase duplicates lines, vectors or points
// line.erase.duplicates.near 1 // erase near lines, vectors or points
// line.erase.duplicates.origin 1 // erase near origin lines, vectors or points
// line.mean.duplicates.near 1 // mean near points

// line.erase.t.min 10 // erase all lines with t < 10
// line.erase.t.max 90 // erase all lines with t > 90

// line.erase.length.min 10 // erase all lines with length < 10
// line.erase.length.max 90 // erase all lines with length > 90

// line.discrete 1 // <1.2,2.3,4.7,4.5> -> <1,2,5,5> // 1*(value/1)
// line.discrete.3d 1 // <1.2,2.3,4.7,4.5> -> <1,2,5,4.5>

// line.vector.norm // norm vectors
// line.vector.normscale 2 // norm and scale vectors
// line.vector.scale 2 // scale vectors
// line.vector.minscale // scale vectors to 1/(min vector)
// line.vector.maxscale // scale vectors to 1/(max vector)
// line.vector.negate // negate (-1*) vectors
// line.vector.invert // invert (1/) vectors

// line.draw.value // set draw to scalar.value
// line.draw.value.t // set draw to scalar.value*t
// line.draw.t // set draw to t

// line.draw.point // draw points into scalar
// line.draw.point.solid // draw solid points into scalar
// line.draw.sphere 3 // draw sphere with radius 3 into scalar
// line.draw.sphere.solid 3 // draw solid sphere with radius 3 into scalar
// line.draw.cube 3 // draw cube with radius 3 into scalar
// line.draw.cube.solid 3 // draw solid cube with radius 3 into scalar
// line.draw.line // draw lines into scalar
// line.draw.line.solid // draw solid lines into scalar
// line.draw // draw points or lines into scalar
// line.draw.solid // draw solid points or lines into scalar

